{
  "name": "device-links-panel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The Device Links sidebar panel for Home Assistant",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "happy-dom": "20.14.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
